{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/agrilearn-impact.html",
      "destination": "/agrilearn-impact",
      "permanent": true
    },
    {
      "source": "/agrilearn-impact-dashboard",
      "destination": "/agrilearn-impact",
      "permanent": true
    },
    {
      "source": "/agrilearn-impact-dashboard.html",
      "destination": "/agrilearn-impact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/agrilearn-impact",
      "destination": "/agrilearn-impact.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/agrilearn-impact",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}