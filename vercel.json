{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/media-information-library",
      "destination": "/media-information-library.html"
    },
    {
      "source": "/media-information-library/",
      "destination": "/media-information-library.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/mobile-app-admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/e-classroom-admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/grants-admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/whsf-website", "destination": "/", "permanent": true },
    { "source": "/whsf-website/:path*", "destination": "/", "permanent": true },
    { "source": "/agrismart", "destination": "/programme-agrismart-ai.html", "permanent": true },
    { "source": "/agrismart/:path*", "destination": "/programme-agrismart-ai.html", "permanent": true },
    { "source": "/agrismart-app.html", "destination": "/programme-agrismart-ai.html", "permanent": true },
    { "source": "/mobile-app.html", "destination": "/programme-agrismart-ai.html", "permanent": true },
    { "source": "/ai-career-connect", "destination": "/programme-ai-career-connect.html", "permanent": true },
    { "source": "/ai-career-connect/:path*", "destination": "/programme-ai-career-connect.html", "permanent": true },
    { "source": "/e-classroom.html", "destination": "/programs.html", "permanent": true },
    { "source": "/e-classroom", "destination": "/programs.html", "permanent": true },
    { "source": "/partner-sponsor.html", "destination": "/corporate-partnerships.html", "permanent": true },
    { "source": "/partner-sponsor", "destination": "/corporate-partnerships.html", "permanent": true }
  ]
}